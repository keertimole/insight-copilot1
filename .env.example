# Copy to .env for local runs. NEVER commit .env or put real keys in this file.
GROQ_API_KEY=your_groq_key_here

# --- optional ---
# LLM_PROVIDER=groq                       # groq | google | openai | anthropic
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b   # used automatically if the main model errors / is rate-limited (default for groq). 'none' disables.
# LLM_FALLBACK_PROVIDER=google            # optional: fall back to a different provider (needs that provider's key + package)
# GOOGLE_API_KEY=your_google_key_here
# CRITIC_LLM_REVIEW=0                     # default 0 = Python-only self-check (no extra LLM call). 1 adds an LLM reviewer.
# ENFORCE_PLANNED_TOOLS=1                 # 1 = the executor only gets the tools named in the planner's plan. 0 = all tools.

# --- persistence & observability (all optional) ---
# CHECKPOINT_DB=checkpoints.db            # save the agent's conversation memory to SQLite (pip install langgraph-checkpoint-sqlite)
# TURN_LOG=logs/turns.jsonl               # one JSON line per question (route, tools, self-check, latency). 'off' disables.
# LANGSMITH_TRACING=true                  # full LLM-level traces in LangSmith (prompts, tokens, per-node latency)
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=insight-copilot
